# Copy to .env.local for local overrides. Never commit real secrets.

# Public site origin. Leave unset until the production domain is confirmed:
# canonical URLs, sitemap and OG absolute URLs are only emitted when this is set.
NEXT_PUBLIC_SITE_URL=

# Content publication mode (spec §10.1):
#   DEMO_CONTENT    — default; sample fixtures, noindex, "Preview content" indicator
#   OWNER_REVIEW    — real CV imported for review; still noindex
#   VERIFIED_PUBLIC — owner-approved publication; build gate rejects any placeholder records
NEXT_PUBLIC_CONTENT_MODE=DEMO_CONTENT

# Assistant mode (spec §9): "demo" uses the local deterministic provider. "live" routes the
# UI to /api/assistant, which returns 503 not_configured until a server-side provider exists.
NEXT_PUBLIC_ASSISTANT_MODE=demo

# Server-only secrets for the future live assistant (G7+). Do not prefix with NEXT_PUBLIC_.
# ASSISTANT_PROVIDER_API_KEY=
