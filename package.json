  "private": true,
  "description": "ISLAM ABD-ELHADY \u2014 The Intelligence Universe. Cinematic interactive 3D portfolio.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:gpu": "node scripts/qa/e2e-gpu.mjs",
    "content:validate": "tsx scripts/content/validate.ts",
    "content:gate": "tsx scripts/content/publication-gate.ts",
    "ai:knowledge": "tsx scripts/ai/knowledge-report.ts",
    "ai:eval:smart": "tsx scripts/ai/eval-smart.ts",
    "fonts:sync": "node scripts/fonts/sync-fonts.mjs && python scripts/fonts/subset-fonts.py",
    "capture:posters": "node scripts/capture/posters.mjs",
    "capture:encode": "python scripts/capture/encode-posters.py",
    "media:process": "python scripts/media/process-media.py",
    "resume:import": "node scripts/resume/import-resume.mjs",
    "perf:lighthouse": "node scripts/perf/lighthouse.mjs",
    "perf:fps": "node scripts/qa/e2e-gpu.mjs -g \"frame-rate profile\"",
    "qa:stations": "node scripts/qa/stations.mjs",
    "qa:record": "node scripts/qa/record.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@mlc-ai/web-llm": "0.2.86",
